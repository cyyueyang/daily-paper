# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 飞书自建应用
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_OWNER_OPEN_ID=ou_xxx        # 只响应此人消息；先填任意值启动 serve，给机器人发消息后从日志拿到真实 open_id 再填回

# 抓取配置
ARXIV_CATEGORIES=cs.CL,cs.LG,cs.AI,cs.RO
ARXIV_FETCH_DAYS=1                  # 首次运行代码内置回退为 3
ARXIV_MAX_AGE_DAYS=365              # 只收最近 1 年内论文（新鲜度兜底）
DAILY_PUSH_TIME=08:00
# 注意：每日入队数量不设上限，抓到多少篇就入队多少篇

# 关键词（逗号分隔，非空时整体覆盖代码默认词表）
EXTRA_KEYWORDS=

# 可选：arXiv 偶发 429 时走代理
HTTP_PROXY=
